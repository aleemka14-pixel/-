rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }

    // --- Specific Collections ---
    match /users/{userId} {
      allow read, write: if true;
    }

    match /players/{playerId} {
      allow read, write: if true;
    }

    match /wallets/{walletId} {
      allow read, write: if true;
    }

    match /transactions/{id} {
      allow read, write: if true;
    }

    match /gameHistory/{id} {
      allow read, write: if true;
    }

    match /bets/{id} {
      allow read, write: if true;
    }

    match /games/{id} {
      allow read, write: if true;
    }

    match /deposits/{id} {
      allow read, write: if true;
    }

    match /withdrawals/{id} {
      allow read, write: if true;
    }

    match /config/{docId} {
      allow read, write: if true;
    }

    match /deposit_networks/{id} {
      allow read, write: if true;
    }

    match /withdrawal_networks/{id} {
      allow read, write: if true;
    }

    match /paymentMethods/{id} {
      allow read, write: if true;
    }

    match /auditLogs/{id} {
      allow read, write: if true;
    }

    match /system_alerts/{id} {
      allow read, write: if true;
    }

    match /notifications/{id} {
      allow read, write: if true;
    }

    match /securityLogs/{id} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true; 
    }
  }
}

